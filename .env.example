# 環境変数設定ファイル
# このファイルを .env にコピーして各値を設定してください。
# cp .env.example .env

# ----- OpenAI API (実験で使用するLLM) -----
OPENAI_API_KEY=sk-your-openai-api-key-here

# ----- DeepL API (翻訳用、オプション) -----
DEEPL_API_KEY=your-deepl-api-key:fx

# ----- Kaggle API (データセットダウンロード用) -----
# https://www.kaggle.com/settings → API → Create New Token からダウンロード
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# ----- Google Gemini API (オプション) -----
GEMINI_API_KEY=your_gemini_api_key

# ----- Anthropic Claude API (オプション) -----
ANTHROPIC_API_KEY=sk-ant-your-key-here
